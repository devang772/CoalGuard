# Copy this file to .env and change the values.
DATABASE_URL=postgresql+psycopg://netra:netra@localhost:5434/khanan_netra

# Secret used to sign login tokens. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins, or * for any (hackathon demo)
CORS_ORIGINS=*

# Create the org tree and demo users automatically when the database is empty
AUTO_BOOTSTRAP=true
DEMO_PASSWORD=demo123

# Background jobs (reminders, escalation ladder, nightly tasks, morning digest).
# Run them in ONE server process only (set false on the others).
SCHEDULER_ENABLED=true
# Demo mode: 60 = one real minute counts as one hour for reminders/escalations (1 = real time)
DEMO_TIME_SPEED=1

# File storage for photos (and reports): local | cloudinary
STORAGE_BACKEND=local
# For cloudinary: copy the "API environment variable" from the Cloudinary dashboard
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=khanan-netra
